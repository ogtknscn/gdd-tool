{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GDD Tool", "version": "0.2.0", "identifier": "com.gddtool.desktop",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:5173", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "GDD Tool", "width": 1280, "height": 800, "minWidth": 1010, "minHeight": 650 }] },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
